// Digital Desa Pro - Prisma Schema
// Compatible with PostgreSQL & Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApplicationSettings {
  id                 String   @id @default("default")
  villageName        String   @default("Desa Sukamaju") @map("village_name")
  districtName       String   @default("Kecamatan Ciawi") @map("district_name")
  regencyName        String   @default("Kabupaten Bogor") @map("regency_name")
  provinceName       String   @default("Jawa Barat") @map("province_name")
  postalCode         String   @default("16720") @map("postal_code")
  officeAddress      String   @default("Jl. Raya Sukamaju No. 12, Jawa Barat") @map("office_address")
  phone              String   @default("(0251) 8245678")
  email              String   @default("pemdes@sukamaju.desa.id")
  website            String   @default("https://sukamaju.desa.id")
  logoUrl            String?  @map("logo_url")
  villageHeadName    String   @default("H. Ahmad Supriyatna, S.AP") @map("village_head_name")
  villageHeadNip     String?  @default("19750812 200212 1 003") @map("village_head_nip")
  secretaryName      String   @default("Budi Santoso, S.Kom") @map("secretary_name")
  letterNumberFormat String   @default("{nomor}/{kode_surat}/DS-SKM/{romawi}/{tahun}") @map("letter_number_format")
  fiscalYear         Int      @default(2026) @map("fiscal_year")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("application_settings")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String?    @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  phone        String?
  avatarUrl    String?    @map("avatar_url")
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  residentId   String?    @map("resident_id")
  resident     Resident?  @relation(fields: [residentId], references: [id])
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  auditLogs    AuditLog[]

  @@map("users")
}

model VillageDistrict {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  headName          String?            @map("head_name")
  phone             String?
  notes             String?
  neighborhoodUnits NeighborhoodUnit[]
  familyCards       FamilyCard[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("village_districts")
}

model NeighborhoodUnit {
  id              String          @id @default(uuid())
  districtId      String          @map("district_id")
  district        VillageDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)
  rwNumber        String          @map("rw_number")
  rtNumber        String          @map("rt_number")
  chairpersonName String?         @map("chairperson_name")
  phone           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([districtId, rwNumber, rtNumber])
  @@map("neighborhood_units")
}

model FamilyCard {
  id             String           @id @default(uuid())
  cardNumber     String           @unique @map("card_number")
  headFamilyName String           @map("head_family_name")
  address        String
  rt             String
  rw             String
  districtId     String?          @map("district_id")
  district       VillageDistrict? @relation(fields: [districtId], references: [id])
  postalCode     String?          @default("16720") @map("postal_code")
  issuedDate     DateTime?        @map("issued_date")
  residents      Resident[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("family_cards")
}

model Resident {
  id             String          @id @default(uuid())
  nik            String          @unique
  familyCardId   String?         @map("family_card_id")
  familyCard     FamilyCard?     @relation(fields: [familyCardId], references: [id])
  cardNumber     String?         @map("card_number")
  fullName       String          @map("full_name")
  birthPlace     String          @map("birth_place")
  birthDate      DateTime        @map("birth_date")
  gender         String
  bloodType      String?         @default("-") @map("blood_type")
  religion       String          @default("Islam")
  maritalStatus  String          @map("marital_status")
  familyRole     String          @map("family_role")
  education      String
  occupation     String
  citizenship    String          @default("WNI")
  fatherName     String?         @map("father_name")
  motherName     String?         @map("mother_name")
  address        String
  rt             String
  rw             String
  districtName   String          @map("district_name")
  phone          String?
  status         String          @default("Tetap")
  deathDate      DateTime?       @map("death_date")
  moveDate       DateTime?       @map("move_date")
  isArchived     Boolean         @default(false) @map("is_archived")
  createdBy      String?         @map("created_by")
  updatedBy      String?         @map("updated_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  users          User[]
  letterRequests LetterRequest[]
  complaints     Complaint[]

  @@map("residents")
}

model VillageOfficial {
  id         String   @id @default(uuid())
  name       String
  nipd       String?
  position   String
  phone      String?
  email      String?
  photoUrl   String?  @map("photo_url")
  orderIndex Int      @default(1) @map("order_index")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("village_officials")
}

model LetterType {
  id                 String          @id @default(uuid())
  code               String          @unique
  name               String
  category           String          @default("Keterangan")
  description        String?
  requiredDocuments  String[]        @map("required_documents")
  validityPeriodDays Int             @default(30) @map("validity_period_days")
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  letterRequests     LetterRequest[]

  @@map("letter_types")
}

model LetterRequest {
  id                   String      @id @default(uuid())
  requestNumber        String?     @unique @map("request_number")
  officialLetterNumber String?     @map("official_letter_number")
  letterTypeId         String      @map("letter_type_id")
  letterType           LetterType  @relation(fields: [letterTypeId], references: [id])
  letterTypeCode       String      @map("letter_type_code")
  letterTypeName       String      @map("letter_type_name")
  residentId           String      @map("resident_id")
  resident             Resident    @relation(fields: [residentId], references: [id])
  nik                  String
  residentName         String      @map("resident_name")
  purpose              String
  extraFields          Json?       @map("extra_fields")
  status               String      @default("Diajukan")
  submissionChannel    String      @default("Loket") @map("submission_channel")
  rejectionReason      String?     @map("rejection_reason")
  processedBy          String?     @map("processed_by")
  processedAt          DateTime?   @map("processed_at")
  approvedBy           String?     @map("approved_by")
  approvedAt           DateTime?   @map("approved_at")
  qrCodeHash           String?     @map("qr_code_hash")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@map("letter_requests")
}

model Announcement {
  id            String   @id @default(uuid())
  title         String
  category      String   @default("Umum")
  content       String
  isPinned      Boolean  @default(false) @map("is_pinned")
  publishedDate DateTime @default(now()) @map("published_date")
  authorName    String   @default("Pemerintah Desa") @map("author_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model Complaint {
  id            String    @id @default(uuid())
  ticketNumber  String    @unique @map("ticket_number")
  residentId    String?   @map("resident_id")
  resident      Resident? @relation(fields: [residentId], references: [id])
  residentName  String    @map("resident_name")
  nik           String
  phone         String?
  category      String
  subject       String
  description   String
  location      String?
  photoUrl      String?   @map("photo_url")
  status        String    @default("Menunggu")
  responseNotes String?   @map("response_notes")
  respondedBy   String?   @map("responded_by")
  respondedAt   DateTime? @map("responded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("complaints")
}

model VillageAsset {
  id              String   @id @default(uuid())
  itemCode        String   @unique @map("item_code")
  itemName        String   @map("item_name")
  category        String
  acquisitionYear Int      @map("acquisition_year")
  sourceOfFunds   String   @map("source_of_funds")
  purchaseCost    Float    @default(0) @map("purchase_cost")
  condition       String   @default("Baik")
  location        String
  picOfficial     String   @map("pic_official")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("village_assets")
}

model IncomingLetter {
  id                      String   @id @default(uuid())
  agendaNumber            String   @unique @map("agenda_number")
  letterNumber            String   @map("letter_number")
  sender                  String
  letterDate              DateTime @map("letter_date")
  receivedDate            DateTime @map("received_date")
  subject                 String
  dispositionTo           String?  @map("disposition_to")
  dispositionInstructions String?  @map("disposition_instructions")
  attachmentUrl           String?  @map("attachment_url")
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("incoming_letters")
}

model OutgoingLetter {
  id           String   @id @default(uuid())
  agendaNumber String   @unique @map("agenda_number")
  letterNumber String   @map("letter_number")
  recipient    String
  letterDate   DateTime @map("letter_date")
  subject      String
  signedBy     String   @map("signed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("outgoing_letters")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  username    String
  action      String
  module      String
  description String
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
